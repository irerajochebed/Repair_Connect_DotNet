@page
@model RepairConnect.Pages.ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
    ViewData["PageSurface"] = true;
}

<section class="error-section">
    <div class="container">
        <div class="panel error-panel">
            <span class="icon-tile">@Ui.Icon("tool")</span>
            <span class="eyebrow d-block">LET'S GET YOU BACK ON TRACK</span>
            <h1>Something went wrong.</h1>
            <p>We couldn't load this page. Please try again in a moment, or head back home.</p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a class="btn btn-primary" asp-page="/Index">Back to home</a>
                <a class="btn btn-outline-primary" asp-page="/Explore">Find help</a>
            </div>
            @if (Model.ShowRequestId)
            {
                <div class="error-reference">
                    <span>Support reference</span><br />
                    <code>@Model.RequestId</code>
                </div>
            }
        </div>
    </div>
</section>
