<form id="login-form" method="post" action="/Account" asp-antiforgery="false">
    <div id="login-error" class="form-error mb-3" role="alert" tabindex="-1" hidden></div>
    <div class="mb-3">
        <label class="form-label" for="login-email">Email address</label>
        <input class="form-control" id="login-email" type="email" autocomplete="username" placeholder="you@example.com" required maxlength="256" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="login-password">Password</label>
        <div class="password-field">
            <input class="form-control" id="login-password" type="password" autocomplete="current-password" placeholder="Enter your password" required maxlength="128" />
            <button type="button" class="password-toggle" data-password-toggle="login-password" aria-label="Show password">Show</button>
        </div>
    </div>
    <label class="form-check d-flex align-items-center gap-2 mb-3">
        <input class="form-check-input mt-0" id="remember-me" type="checkbox" /> <span>Keep me signed in on this device</span>
    </label>
    <button class="btn btn-primary w-100 mt-2" id="login-submit" type="submit">Sign in</button>
    <p class="form-footnote">Use your own account on a trusted device.</p>
</form>
