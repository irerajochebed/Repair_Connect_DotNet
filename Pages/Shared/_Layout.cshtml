
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RepairConnect</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="topBar">
                <a  class="logo" asp-area="" asp-page="/Index">Repair Connect</a>
                <div class="topLinks">
                    <a asp-page="/Index" class="linker">Home</a>
                    <a class="linker" asp-area="" asp-page="/Explore">Services</a>
                    <a class="linker" asp-area="" asp-page="/Privacy">What we offer</a>

                </div>

                <div class="loginDiv">
                    <a class="logs login" asp-area="" asp-page="/Login">Login</a>
                    <a class="logs signup" asp-area="" asp-page="/Signup">Signup</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RepairConnect - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
