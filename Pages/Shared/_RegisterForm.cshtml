<form id="register-form" class="signup-form" method="post" action="/Account" asp-antiforgery="false">
    <div class="form-error signup-full" id="register-error" role="alert" tabindex="-1" hidden></div>
    <div><label class="form-label" for="register-name">Username *</label><input class="form-control" id="register-name" required maxlength="100" pattern=".*\S.*" autocomplete="username" placeholder="Username" /><div class="invalid-feedback" id="register-name-error"></div></div>
    <div><label class="form-label" for="register-email">Email address *</label><input class="form-control" id="register-email" type="email" required maxlength="256" autocomplete="email" placeholder="Email" /><div class="invalid-feedback" id="register-email-error"></div></div>
    <div><label class="form-label" for="register-password">Password *</label><div class="password-field"><input class="form-control" id="register-password" placeholder="Password" type="password" required minlength="8" maxlength="128" autocomplete="new-password" aria-describedby="register-password-hint" /><button class="password-toggle" type="button" data-password-toggle="register-password" aria-label="Show password">Show</button></div><div class="field-hint" id="register-password-hint">At least 8 characters.</div><div class="invalid-feedback" id="register-password-error"></div></div>
    <div><label class="form-label" for="confirm-password">Confirm password *</label><div class="password-field"><input class="form-control" id="confirm-password" placeholder="Confirm password" type="password" required minlength="8" maxlength="128" autocomplete="new-password" /><button class="password-toggle" type="button" data-password-toggle="confirm-password" aria-label="Show confirmed password">Show</button></div><div class="invalid-feedback" id="register-confirm-error"></div></div>
    <div><label class="form-label" for="register-phone">Phone <span class="optional">(optional)</span></label><input class="form-control" id="register-phone" type="tel" maxlength="20" autocomplete="tel" placeholder="Phone" /><div class="invalid-feedback" id="register-phone-error"></div></div>
    <div><label class="form-label" for="register-dob">Date of birth <span class="optional">(optional)</span></label><input class="form-control" id="register-dob" name="dateOfBirth" type="date" /></div>
    <button class="btn btn-primary w-100 signup-full" id="register-submit" type="submit">Create account</button>
</form>
