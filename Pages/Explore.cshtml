@page
@{ ViewData["Title"] = "Find help"; ViewData["PageSurface"] = true; }
<section class="page-intro"><div class="container">
    <span class="eyebrow">PEOPLE WITH THE RIGHT SKILLS</span>
    <h1>Good people. The right skills.</h1>
    <p>Find a technician by service and location when the directory becomes available.</p>
</div></section>
<section class="container section-space pt-0">
    <div class="panel empty-state">
        <span class="icon-tile">@Ui.Icon("users")</span>
        <h2>The technician directory is coming soon.</h2>
        <p>Verified technician profiles will appear here once the directory service is ready.</p>
        <a class="btn btn-outline-primary" asp-page="/Index">Back to home</a>
    </div>
</section>
