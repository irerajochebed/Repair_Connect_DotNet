@page
@model RepairConnect.Pages.LoginModel
@{
	ViewData["Title"] = "Login";
}

<div class="login-container">
	<div class="login">
		<p class="title">Login</p>
		<form>
			<div class="fields">
				<p class="fil">Email</p>
				<input class="input"/>
			</div>
			<div class="fields">
				<p class="fil">Password</p>
				<input class="input" type="password"/>
			</div>

			<div class="fi">
				<button class="loginBtn">Login</button>
			</div>
		</form>
	</div>
</div>
